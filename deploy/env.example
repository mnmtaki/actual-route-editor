# Copy to deploy/.env; never commit your real password.
POSTGRES_PASSWORD=replace-with-a-long-unique-random-password
# Local single-machine demo (HTTP only). For production set external HTTPS
# origin and ARA_COOKIE_SECURE=true behind a TLS terminator.
ARA_ORIGIN=http://localhost:8088
ARA_COOKIE_SECURE=false
ARA_HTTP_PORT=8088
ARA_BIND_ADDRESS=127.0.0.1
