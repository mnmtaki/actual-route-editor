{
  "name": "fictional-metro-actual-route-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-single-html.mjs",
    "build:web": "tsc -b && node scripts/build-single-html.mjs",
    "typecheck": "tsc -b",
    "build:vite": "tsc -b && vite build --outDir dist-vite",
    "diagnose:offline": "node scripts/diagnose-offline.mjs dist/index.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:pwa": "tsc -b && node scripts/build-pwa.mjs",
    "android:apk": "node scripts/android-apk.mjs",
    "android:install": "node scripts/android-install.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@vitejs/plugin-react": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "latest",
    "jsdom": "^26.1.0",
    "vitest": "latest"
  }
}
